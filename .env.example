# Root-level env consumed by docker-compose.yml only.
# These get passed as build-args into the Next.js image so that
# NEXT_PUBLIC_* values are baked in at build time.
#
# The backend's runtime env lives in ./backend/.env — see backend/.env.example.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
