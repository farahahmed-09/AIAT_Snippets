# App
ENVIRONMENT=development
DEBUG=true

# CORS — comma-separated, JSON array also works
CORS_ORIGINS=["http://localhost:3000"]

# Supabase — Project Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_*) — browser-safe, used as the anon role
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_*) — bypasses RLS, server-only
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=snippets

# User-token verification uses the project's JWKS endpoint
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json) with ES256. No shared
# JWT secret needed — the asymmetric public key is fetched at runtime.

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# ─── ai_core (LLM routing via LiteLLM proxy) ───────────────────────────
# All LLM + audio transcription traffic goes through this gateway.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
# Default chat model (LiteLLM-style "<provider>/<model>" string).
DEFAULT_MODEL=openai/gpt-4o-mini
